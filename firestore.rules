rules_version = '2';

// PensionTools — Firestore security rules.
//
// All personal data lives under users/{uid}/... (scenarios/{scenarioId},
// profile/settings). Each signed-in, email-verified user may access only
// their own subtree; everything else is denied by default.
//
// Note: email_verified is true for all Google sign-ins. Email/password
// accounts must verify their address (see compliance/GDPR_TODO.md P2)
// before they can read or write data.
//
// Deploy with: firebase deploy --only firestore:rules

service cloud.firestore {
  match /databases/{db}/documents {
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null
                         && request.auth.uid == uid
                         && request.auth.token.email_verified == true;
    }
  }
}
