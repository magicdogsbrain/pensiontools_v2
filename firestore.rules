rules_version = '2';

// PensionTools — Firestore security rules.
//
// All personal data lives under users/{uid}/... (scenarios/{scenarioId},
// profile/settings). Each signed-in, email-verified user may access only
// their own subtree; everything else is denied by default.
//
// Note: email_verified is true for all Google sign-ins. Email/password
// accounts must verify their address (see compliance/GDPR_TODO.md P2)
// before they can read or write data.
//
// Deploy with: firebase deploy --only firestore:rules

service cloud.firestore {
  match /databases/{db}/documents {
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null
                         && request.auth.uid == uid
                         && request.auth.token.email_verified == true;
    }

    // Administrator probe + soft-lock passphrase: readable/writable ONLY by the administrator.
    // The client contains no admin identifier — it simply attempts this read; these rules are
    // the (server-side) authority on who the administrator is.
    match /adminPrivate/{docId} {
      allow read, write: if request.auth != null && request.auth.uid == 'K5BLVvYKtzWTzqWqT5qUH7EqrwU2';
    }

    // Shared curated datasets (fund catalogue, sub-asset profile tuning, typical amounts):
    // readable by any signed-in verified user; writable only by the administrator account.
    match /admin/{docId} {
      allow read: if request.auth != null && request.auth.token.email_verified == true;
      allow write: if request.auth != null && request.auth.uid == 'K5BLVvYKtzWTzqWqT5qUH7EqrwU2';
    }

    // Unknown-fund categorisation queue: any signed-in verified user may submit their own
    // suggestion; only the administrator may read or manage the queue.
    match /fundSuggestions/{suggestionId} {
      allow create: if request.auth != null
                    && request.auth.token.email_verified == true
                    && request.resource.data.uid == request.auth.uid;
      allow read, update, delete: if request.auth != null
                                  && request.auth.uid == 'K5BLVvYKtzWTzqWqT5qUH7EqrwU2';
    }
  }
}
